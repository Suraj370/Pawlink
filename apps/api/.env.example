NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://pawlink:pawlink@localhost:5432/pawlink
WEB_ORIGIN=http://localhost:5173
# Signs/verifies the MOCK payment provider's webhooks only — not a real
# payment credential. Safe to leave as the default for local dev/test,
# but MUST be overridden with a real, unique value in production — see
# env.ts, which fails startup if production is still using this default.
MOCK_PAYMENT_WEBHOOK_SECRET=dev-mock-payment-webhook-secret
# Optional. Unset in development/test — rate limiting simply runs as a
# no-op without it (see middleware/rateLimit.ts). REQUIRED in production
# — env.ts fails startup without it. Uncomment to exercise rate limiting
# locally (requires `docker compose up -d redis`):
# REDIS_URL=redis://localhost:6379
# Optional. A safe, non-secret build identifier (a commit SHA, a CI build
# number) surfaced through GET /health. Left unset in local development;
# a real deployment sets this at build/deploy time — see
# apps/api/Dockerfile and docker-compose.prod.yml.
# APP_VERSION=
# Optional, defaults to false. Whether to trust an incoming X-Forwarded-For
# header for rate-limit IP keying (see lib/clientIp.ts). Leave this false
# unless a real reverse proxy that is the sole public entry point sits in
# front of this process and itself sets/overwrites that header —
# docker-compose.prod.yml as shipped publishes the API's port directly to
# the host with no such proxy, so flipping this to true there would let
# any client spoof the header and bypass every rate limit.
# TRUST_PROXY=false
