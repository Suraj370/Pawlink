{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": ["vite.config.ts"]
}
