{
  "name": "pawlink",
  "private": true,
  "version": "0.1.0",
  "description": "PawLink: a multi-sided pet-care platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace packages/shared && npm run build --workspace apps/api && npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace apps/api",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace apps/api",
    "db:migrate": "npm run db:migrate --workspace apps/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
